App(
    appid="fasting_tracker",
    name="Fasting Tracker",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="fasting_tracker_app",
    requires=["gui", "storage", "notification"],
    stack_size=2 * 1024,
